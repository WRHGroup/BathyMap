{
    "site_title": "BathyMap",
    "site_description": "Raw bathymetry survey data. Explore each survey line on the map, read the depth, date and time of individual soundings, and download the original files, CSV exports, or any area you select.",
    "organisation": "",
    "contact": "",
    "licence": "",
    "repository_url": "",
    "repository_branch": "main",
    "data_directory": "data",
    "site_template_directory": "site",
    "output_directory": "docs",
    "file_extensions": [
        ".dep"
    ],
    "accepted_gps_states": [],
    "max_map_points_per_line": 3000,
    "max_track_points_per_line": 200,
    "copy_raw_files": true,
    "write_combined_csv": true,
    "survey_metadata": {},
    "metadata_file_name": "metadata.json",
    "time_reference": "as logged by the instrument",
    "depth_reference": "as logged by the instrument",
    "height_reference": "GNSS heights above the ellipsoid, as logged (no geoid model applied). They are not heights above sea level and do not match the contours of the topographic basemap; the difference depends on the location.",
    "default_basemap": "openstreetmap",
    "map_variables": [
        {
            "column": "Depth",
            "label": "Water depth",
            "unit": "m",
            "colours": "depth",
            "decimals": 3,
            "group": "Bathymetry"
        },
        {
            "column": "Height - Depth",
            "label": "Bed elevation",
            "note": "GNSS height minus water depth. Above the ellipsoid, not sea level",
            "unit": "m",
            "colours": "elevation",
            "decimals": 3,
            "group": "Bathymetry"
        },
        {
            "column": "Height",
            "label": "GNSS height",
            "note": "Above the ellipsoid, not sea level",
            "unit": "m",
            "colours": "sequential",
            "decimals": 3,
            "group": "Bathymetry"
        },
        {
            "column": "Time of day",
            "label": "Time of day",
            "unit": "",
            "colours": "sequential",
            "decimals": 0,
            "format": "time",
            "group": "Survey"
        },
        {
            "column": "Trail Distance",
            "label": "Distance along line",
            "note": "From the first sounding of each line",
            "unit": "m",
            "from_line_start": true,
            "colours": "sequential",
            "decimals": 1,
            "group": "Survey"
        },
        {
            "column": "Speed",
            "label": "Platform speed",
            "unit": "m/s",
            "colours": "sequential",
            "decimals": 2,
            "group": "Survey"
        },
        {
            "column": "Flow Velocity",
            "label": "Flow velocity",
            "unit": "m/s",
            "colours": "sequential",
            "decimals": 2,
            "group": "Survey"
        },
        {
            "column": "Roll",
            "label": "Roll",
            "note": "Logged in radians, shown in degrees",
            "unit": "°",
            "scale": 57.29578,
            "colours": "diverging",
            "decimals": 1,
            "group": "Quality"
        },
        {
            "column": "Pitch",
            "label": "Pitch",
            "note": "Logged in radians, shown in degrees",
            "unit": "°",
            "scale": 57.29578,
            "colours": "diverging",
            "decimals": 1,
            "group": "Quality"
        },
        {
            "column": "Diff Delay",
            "label": "Correction age",
            "note": "Age of the RTK corrections",
            "unit": "s",
            "colours": "sequential",
            "decimals": 1,
            "group": "Quality"
        },
        {
            "column": "HRMS",
            "label": "Horizontal precision",
            "unit": "m",
            "colours": "sequential",
            "decimals": 3,
            "group": "Quality"
        },
        {
            "column": "VRMS",
            "label": "Vertical precision",
            "unit": "m",
            "colours": "sequential",
            "decimals": 3,
            "group": "Quality"
        },
        {
            "column": "GPS State",
            "label": "GPS state",
            "note": "1 GPS, 2 DGPS, 4 RTK fixed, 5 RTK float",
            "unit": "",
            "colours": "sequential",
            "decimals": 0,
            "group": "Quality"
        }
    ],
    "carto_api_key": "",
    "start_with_list_collapsed": true
}

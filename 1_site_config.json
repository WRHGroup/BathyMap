{
    "site_title": "BathyMap",
    "site_description": "This website shares raw bathymetry data collected in field surveys. Each survey line can be viewed on the map, with the depth, date, and time of individual soundings, and in 3D. The original files, CSV exports, and the soundings within any selected area can be downloaded.",
    "organisation": "",
    "contact": "",
    "licence": "",
    "show_disclaimer": true,
    "disclaimer": {
        "title": "Disclaimer",
        "paragraphs": [
            "The bathymetry data on this website are raw survey measurements shared for research and education. The data are provided \"as is\", without warranty of any kind, express or implied, including warranties of accuracy, completeness, currency, or fitness for a particular purpose.",
            "The depths were not corrected for changes in water level, and the soundings can contain errors. The coloured surface in the 3D view is interpolated between soundings for visualisation only and is not a measurement.",
            "The data must not be used for navigation or for any purpose related to safety on the water.",
            "The research group and the institutions involved in collecting and publishing the data accept no liability for any loss, damage, or injury arising from the use of the data or from errors or omissions in them. Users are responsible for assessing whether the data are suitable for their purpose."
        ],
        "button": "I understand"
    },
    "repository_url": "",
    "repository_branch": "main",
    "data_directory": "data",
    "site_template_directory": "site",
    "output_directory": "docs",
    "file_extensions": [
        ".dep"
    ],
    "accepted_gps_states": [],
    "max_map_points_per_line": 3000,
    "max_track_points_per_line": 200,
    "copy_raw_files": true,
    "write_combined_csv": true,
    "survey_metadata": {},
    "metadata_file_name": "metadata.json",
    "time_reference": "as recorded by the instrument",
    "depth_reference": "as recorded by the instrument",
    "height_reference": "GNSS heights relative to the ellipsoid, as recorded (no geoid model was applied). Therefore, they are not heights above sea level and differ from the contours of the topographic basemap by an amount that depends on the location.",
    "default_basemap": "openstreetmap",
    "map_variables": [
        {
            "column": "Depth",
            "label": "Water depth",
            "unit": "m",
            "colours": "depth",
            "decimals": 3,
            "group": "Bathymetry"
        },
        {
            "column": "Height - Depth",
            "label": "Bed elevation",
            "note": "GNSS height minus water depth, relative to the ellipsoid (not sea level).",
            "unit": "m",
            "colours": "elevation",
            "decimals": 3,
            "group": "Bathymetry"
        },
        {
            "column": "Height",
            "label": "GNSS height",
            "note": "Relative to the ellipsoid (not sea level).",
            "unit": "m",
            "colours": "sequential",
            "decimals": 3,
            "group": "Bathymetry"
        },
        {
            "column": "Time of day",
            "label": "Time of day",
            "unit": "",
            "colours": "sequential",
            "decimals": 0,
            "format": "time",
            "group": "Survey"
        },
        {
            "column": "Trail Distance",
            "label": "Distance along line",
            "note": "Measured from the first sounding of each line.",
            "unit": "m",
            "from_line_start": true,
            "colours": "sequential",
            "decimals": 1,
            "group": "Survey"
        },
        {
            "column": "Speed",
            "label": "Platform speed",
            "unit": "m/s",
            "colours": "sequential",
            "decimals": 2,
            "group": "Survey"
        },
        {
            "column": "Flow Velocity",
            "label": "Flow velocity",
            "unit": "m/s",
            "colours": "sequential",
            "decimals": 2,
            "group": "Survey"
        },
        {
            "column": "Roll",
            "label": "Roll",
            "note": "Recorded in radians and shown in degrees.",
            "unit": "°",
            "scale": 57.29578,
            "colours": "diverging",
            "decimals": 1,
            "group": "Quality"
        },
        {
            "column": "Pitch",
            "label": "Pitch",
            "note": "Recorded in radians and shown in degrees.",
            "unit": "°",
            "scale": 57.29578,
            "colours": "diverging",
            "decimals": 1,
            "group": "Quality"
        },
        {
            "column": "Diff Delay",
            "label": "Correction age",
            "note": "Age of the RTK corrections.",
            "unit": "s",
            "colours": "sequential",
            "decimals": 1,
            "group": "Quality"
        },
        {
            "column": "HRMS",
            "label": "Horizontal precision",
            "unit": "m",
            "colours": "sequential",
            "decimals": 3,
            "group": "Quality"
        },
        {
            "column": "VRMS",
            "label": "Vertical precision",
            "unit": "m",
            "colours": "sequential",
            "decimals": 3,
            "group": "Quality"
        },
        {
            "column": "GPS State",
            "label": "GPS state",
            "unit": "",
            "colours": "categories",
            "categories": {
                "4": {
                    "label": "RTK fixed",
                    "colour": "#1a9850"
                },
                "5": {
                    "label": "RTK float",
                    "colour": "#fdd835"
                },
                "2": {
                    "label": "DGPS",
                    "colour": "#fb8c00"
                },
                "1": {
                    "label": "GPS (single)",
                    "colour": "#d32f2f"
                },
                "3": {
                    "label": "PPS",
                    "colour": "#8e24aa"
                },
                "6": {
                    "label": "Estimated",
                    "colour": "#6d4c41"
                },
                "0": {
                    "label": "Invalid",
                    "colour": "#212121"
                }
            },
            "decimals": 0,
            "group": "Quality"
        }
    ],
    "carto_api_key": "",
    "start_with_list_collapsed": true,
    "interpolate_bed": true,
    "bed_grid_spacing": 0.5,
    "bed_max_distance": 0,
    "bed_max_gap": 30,
    "bed_pass_ratio": 2,
    "bed_fill_enclosed_holes": true,
    "vertical_exaggeration": "auto",
    "bed_max_points": 250000
}
